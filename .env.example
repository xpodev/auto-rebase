# Required
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_REPO=owner/repo

# Multi-line PEM: wrap in quotes with real line breaks preserved, e.g.
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# ...
# -----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY=

# Optional (defaults shown)
BASE_BRANCH=main
POLL_INTERVAL_MS=60000
# How long a tracked PR may stay unmerged before moving on (e.g. 30s, 5m, 16h, 40d, 1h30m).
# Unset = never stale.
# STALE_TIMEOUT=16h
# CONFIG='{"ciChecks":["build","test"],"priorityOrder":[["AUTO_MERGE_ON","CI_PASSING"],["CI_PASSING"],["AUTO_MERGE_ON"]]}'
